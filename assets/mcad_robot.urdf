<?xml version="1.0" ?>
<!--
  Standalone URDF for PyBullet RL Training
  Generated from mcad_robot_r2 xacro files (prefix = r2)
  6DOF arm + 1DOF gripper (joint7) + tool0 end-effector
  Gripper mimic joints EXCLUDED (PyBullet doesn't support mimic natively)
-->
<robot name="mcad_robot_r2">

  <!-- ===== WORLD FIXED BASE ===== -->
  <link name="world"/>

  <link name="r2_base_footprint"/>
  <joint name="r2_world_joint" type="fixed">
    <parent link="world"/>
    <child link="r2_base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== BASE LINK ===== -->
  <link name="r2_base_link">
    <inertial>
      <origin xyz="-0.00121 0.00043 0.03746" rpy="0 0 0"/>
      <mass value="1.3087"/>
      <inertia ixx="0.0035" ixy="-5.75e-06" ixz="-1.23e-05"
               iyy="0.0035" iyz="1.66e-05" izz="0.0060"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_link.STL" scale="1 1 1"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="r2_base_joint" type="fixed">
    <parent link="r2_base_footprint"/>
    <child link="r2_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== JOINT 1: Base Rotation (Z-axis) ===== -->
  <link name="r2_link1">
    <inertial>
      <origin xyz="0.00022 -0.00015 0.01931" rpy="0 0 0"/>
      <mass value="0.6955"/>
      <inertia ixx="0.0007" ixy="-1.35e-07" ixz="-5.36e-06"
               iyy="0.0007" iyz="4.74e-06" izz="0.0010"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_1.STL" scale="1 1 1"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint1" type="revolute">
    <parent link="r2_base_link"/>
    <child link="r2_link1"/>
    <origin xyz="0 0 0.0546" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== JOINT 2: Shoulder (Y-axis) ===== -->
  <link name="r2_link2">
    <inertial>
      <origin xyz="-0.0161 -0.0193 0.0622" rpy="0 0 0"/>
      <mass value="0.3232"/>
      <inertia ixx="0.00042" ixy="-2.58e-07" ixz="1.21e-05"
               iyy="0.00042" iyz="6.46e-06" izz="9.52e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_2.STL" scale="1 1 1"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.01 0 0.055" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.11"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint2" type="revolute">
    <parent link="r2_link1"/>
    <child link="r2_link2"/>
    <origin xyz="0 0.018625 0.0654" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="1.2217" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== JOINT 3: Elbow (Y-axis) ===== -->
  <link name="r2_link3">
    <inertial>
      <origin xyz="0.0334 -0.0186 0.0358" rpy="0 0 0"/>
      <mass value="0.2721"/>
      <inertia ixx="0.00012" ixy="3.64e-07" ixz="-4.33e-05"
               iyy="0.00021" iyz="4.15e-07" izz="0.00017"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_3.STL" scale="1 1 1"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.035 -0.01 0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.03 0.05"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint3" type="revolute">
    <parent link="r2_link2"/>
    <child link="r2_link3"/>
    <origin xyz="-0.019837 0.0002 0.11485" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8378" upper="0.5236" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== JOINT 4: Forearm Roll (X-axis) ===== -->
  <link name="r2_link4">
    <inertial>
      <origin xyz="0.0268 0.0014 -7.26e-05" rpy="0 0 0"/>
      <mass value="0.1365"/>
      <inertia ixx="2.64e-05" ixy="-8.97e-07" ixz="-8.69e-08"
               iyy="4.12e-05" iyz="1.59e-08" izz="4.35e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_4.STL" scale="1 1 1"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.023 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.02" length="0.046"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint4" type="revolute">
    <parent link="r2_link3"/>
    <child link="r2_link4"/>
    <origin xyz="0.068886 -0.019644 0.031853" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.58" upper="1.58" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== JOINT 5: Wrist Pitch (Y-axis) ===== -->
  <link name="r2_link5">
    <inertial>
      <origin xyz="0.0275 0.0185 0.0091" rpy="0 0 0"/>
      <mass value="0.1656"/>
      <inertia ixx="6.44e-05" ixy="3.09e-08" ixz="-3.94e-06"
               iyy="6.59e-05" iyz="1.85e-07" izz="4.46e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_5.STL" scale="1 1 1"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.025 0.01 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint5" type="revolute">
    <parent link="r2_link4"/>
    <child link="r2_link5"/>
    <origin xyz="0.04612 -0.01862 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.85" upper="0.85" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== JOINT 6: Wrist Roll (X-axis) ===== -->
  <link name="r2_link6">
    <inertial>
      <origin xyz="0.0259 -0.0002 -0.0199" rpy="0 0 0"/>
      <mass value="0.1046"/>
      <inertia ixx="2.72e-05" ixy="1.71e-07" ixz="1.60e-06"
               iyy="1.78e-05" iyz="1.69e-07" izz="2.37e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link_6.STL" scale="1 1 1"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.025 0 -0.01" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.018" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint6" type="revolute">
    <parent link="r2_link5"/>
    <child link="r2_link6"/>
    <origin xyz="0.05089 0.01862 0.00031" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.58" upper="1.58" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- ===== TOOL LINK (fixed to link6) ===== -->
  <link name="r2_tool_link">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="r2_tool_link_joint" type="fixed">
    <parent link="r2_link6"/>
    <child link="r2_tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== TOOL0 / TCP (Tool Center Point) ===== -->
  <link name="r2_tool0">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="r2_tool0_fixed_joint" type="fixed">
    <parent link="r2_tool_link"/>
    <child link="r2_tool0"/>
    <origin xyz="0.09 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== JOINT 7: Gripper (Y-axis) ===== -->
  <link name="r2_gripper_base_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.06 0.02"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.06 0.02"/></geometry>
    </collision>
  </link>
  <joint name="r2_joint7" type="revolute">
    <parent link="r2_tool_link"/>
    <child link="r2_gripper_base_link"/>
    <origin xyz="0.027 -0.014 -0.00063333" rpy="1.570 0 1.57"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.65" upper="0.65" effort="1.5" velocity="2"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

</robot>
