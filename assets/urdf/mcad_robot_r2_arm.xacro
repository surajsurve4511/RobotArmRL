<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="r2_mesh_package" value="mcad_robot_r2"/>    
    <xacro:property name="base_link" value="package://${r2_mesh_package}/meshes/base_link.STL"/>
    <xacro:property name="link_1" value="package://${r2_mesh_package}/meshes/link_1.STL"/>
    <xacro:property name="link_2" value="package://${r2_mesh_package}/meshes/link_2.STL"/>
    <xacro:property name="link_3" value="package://${r2_mesh_package}/meshes/link_3.STL"/>
    <xacro:property name="link_4" value="package://${r2_mesh_package}/meshes/link_4.STL"/>
    <xacro:property name="link_5" value="package://${r2_mesh_package}/meshes/link_5.STL"/>
    <xacro:property name="link_6" value="package://${r2_mesh_package}/meshes/link_6.STL"/>
    <xacro:property name="mesh_scale" value="1 1 1"/>
    
    <xacro:macro name="mcad_arm_r2" params="prefix:=robot2">
    
    <link name="world" />

    <joint name="${prefix}_world_joint" type="fixed">
        <parent link="world"/>
        <child link="${prefix}_base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_base_footprint" />

    <joint name="${prefix}_base_joint" type="fixed">
        <parent link="${prefix}_base_footprint"/>
        <child link="${prefix}_base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_base_link">
        <inertial>
            <origin xyz="-0.00121 0.00043 0.03746" rpy="0 0 0" />
            <mass value="1.3087" />
            <inertia ixx="0.0035" ixy="-5.75e-06" ixz="-1.23e-05"
                     iyy="0.0035" iyz="1.66e-05" izz="0.0060" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${base_link}" scale="${mesh_scale}"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry><mesh filename="${base_link}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>

    <link name="${prefix}_link1">
        <inertial>
            <origin xyz="0.00022 -0.00015 0.01931" rpy="0 0 0" />
            <mass value="0.6955" />
            <inertia ixx="0.0007" ixy="-1.35e-07" ixz="-5.36e-06"
                     iyy="0.0007" iyz="4.74e-06" izz="0.0010" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_1}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_1}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint1" type="revolute">
        <parent link="${prefix}_base_link"/>
        <child link="${prefix}_link1"/>
        <origin xyz="0 0 0.0546" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_link2">
        <inertial>
            <origin xyz="-0.0161 -0.0193 0.0622" rpy="0 0 0" />
            <mass value="0.3232" />
            <inertia ixx="0.00042" ixy="-2.58e-07" ixz="1.21e-05"
                     iyy="0.00042" iyz="6.46e-06" izz="9.52e-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_2}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_2}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint2" type="revolute">
        <parent link="${prefix}_link1"/>
        <child link="${prefix}_link2"/>
        <origin xyz="0 0.018625 0.0654" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
        <limit lower="-0.5236" upper="1.2217" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_link3">
        <inertial>
            <origin xyz="0.0334 -0.0186 0.0358" rpy="0 0 0" />
            <mass value="0.2721" />
            <inertia ixx="0.00012" ixy="3.64e-07" ixz="-4.33e-05"
                     iyy="0.00021" iyz="4.15e-07" izz="0.00017" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_3}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_3}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint3" type="revolute">
        <parent link="${prefix}_link2"/>
        <child link="${prefix}_link3"/>
        <origin xyz="-0.019837 0.0002 0.11485" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
        <limit lower="-0.8378" upper="0.5236" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_link4">
        <inertial>
            <origin xyz="0.0268 0.0014 -7.26e-05" rpy="0 0 0" />
            <mass value="0.1365" />
            <inertia ixx="2.64e-05" ixy="-8.97e-07" ixz="-8.69e-08"
                     iyy="4.12e-05" iyz="1.59e-08" izz="4.35e-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_4}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_4}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint4" type="revolute">
        <parent link="${prefix}_link3"/>
        <child link="${prefix}_link4"/>
        <origin xyz="0.068886 -0.019644 0.031853" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit lower="-1.58" upper="1.58" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_link5">
        <inertial>
            <origin xyz="0.0275 0.0185 0.0091" rpy="0 0 0" />
            <mass value="0.1656" />
            <inertia ixx="6.44e-05" ixy="3.09e-08" ixz="-3.94e-06"
                     iyy="6.59e-05" iyz="1.85e-07" izz="4.46e-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_5}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_5}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint5" type="revolute">
        <parent link="${prefix}_link4"/>
        <child link="${prefix}_link5"/>
        <origin xyz="0.04612 -0.01862 0" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
        <limit lower="-0.85" upper="0.85" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_link6">
        <inertial>
            <origin xyz="0.0259 -0.0002 -0.0199" rpy="0 0 0" />
            <mass value="0.1046" />
            <inertia ixx="2.72e-05" ixy="1.71e-07" ixz="1.60e-06"
                     iyy="1.78e-05" iyz="1.69e-07" izz="2.37e-05" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><mesh filename="${link_6}" scale="${mesh_scale}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><mesh filename="${link_6}" scale="${mesh_scale}"/></geometry>
        </collision>
    </link>
    <joint name="${prefix}_joint6" type="revolute">
        <parent link="${prefix}_link5"/>
        <child link="${prefix}_link6"/>
        <origin xyz="0.05089 0.01862 0.00031" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit lower="-1.58" upper="1.58" effort="3.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_tool_link">
        <inertial>
            <mass value="0.0001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
    </link>

    <joint name="${prefix}_tool_link_joint" type="fixed">
        <parent link="${prefix}_link6"/>
        <child link="${prefix}_tool_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    </xacro:macro>

</robot>